# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional management key for credits, account activity, and analytics
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000

# Optional OpenRouter app attribution
OPENROUTER_SITE_URL=https://your-app.example
OPENROUTER_APP_NAME=OpenRouter MCP Server

# MCP transport: stdio (default) or loopback-only http
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3000
